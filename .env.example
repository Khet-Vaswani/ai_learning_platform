# Copy this file to .env and fill in your own values. Never commit .env.

SECRET_KEY=change-me-to-a-long-random-string

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_learning_platform

GROQ_API_KEY=
GEMINI_API_KEY=
