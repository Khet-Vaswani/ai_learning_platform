# Copy this file to .env and fill in your own values. Never commit .env.
# On a host such as Vercel, add the same keys under Settings → Environment Variables
# (skip the "local only" ones).

# Flask: generate with  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database
# Local (XAMPP):   DB_HOST=localhost  DB_PORT=3306  DB_USER=root  DB_NAME=ai_learning_platform
# Online (Aiven):  use the host, port, user, password and database name from the Aiven service page
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_learning_platform
# Connections each server copy keeps open. Use 2-3 on a free hosted database.
DB_POOL_SIZE=10

# AI and YouTube
GROQ_API_KEY=
GEMINI_API_KEY=
YOUTUBE_API_KEY=

# Optional: social sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional: email for password-reset links. Without it, reset links are only printed
# in the server log. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, your Gmail address
# as SMTP_USER and a Google "App password" (not your normal password) as SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Optional: proxy for YouTube captions and audio. YouTube often blocks requests from
# cloud servers such as Vercel; a residential proxy fixes "couldn't get a transcript".
# Format: http://user:password@host:port
YT_PROXY_URL=

# Local only (do not set on the live site): allows OAuth over plain http://localhost
OAUTHLIB_INSECURE_TRANSPORT=1
