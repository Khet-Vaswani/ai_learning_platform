# Optional: social sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Local development only: allows OAuth over plain http://localhost
OAUTHLIB_INSECURE_TRANSPORT=1
